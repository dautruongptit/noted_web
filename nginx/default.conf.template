# ==========================================================
# nginx/default.conf.template
#
# Day la TEMPLATE, khong phai file config that. Image nginx:1.27 chinh thuc
# tu dong quet moi file trong /etc/nginx/templates/*.template luc container
# khoi dong, chay envsubst de thay ${BACKEND_HOST} / ${BACKEND_PORT} bang
# gia tri bien moi truong THAT (dat trong Dockerfile hoac docker-compose.yml),
# roi ghi ket qua ra /etc/nginx/conf.d/default.conf truoc khi nginx start.
#
# Ly do dung reverse proxy thay vi de FE goi thang toi backend:
#  - Trinh duyet chi thay 1 origin DUY NHAT (vd http://localhost:8200) ->
#    KHONG CON VAN DE CORS gi ca (khong can ALLOWED_ORIGINS whitelist phuc tap
#    nhu da cau hinh o backend SecurityConfig).
#  - Cookie httpOnly "refresh_token" (path=/api/auth, xem SEC-06) hoat dong
#    dung vi request toi /api/auth/refresh van la same-origin voi trang FE.
# ==========================================================

# Giao thuc THAT ma nguoi dung dung. nginx nay nam SAU Cloudflare Tunnel: tunnel
# noi toi nginx bang HTTP thuong, nen $scheme luon la "http" du nguoi dung vao
# bang https. Truoc day truyen thang $scheme cho backend -> Spring dung redirect_uri
# "http://noted.../login/oauth2/code/google" -> Google tu choi ("khong ket noi
# duoc"/redirect_uri_mismatch). Cloudflare gui san X-Forwarded-Proto: https, nen
# uu tien header do; neu khong co (truy cap truc tiep qua localhost) thi dung $scheme.
map $http_x_forwarded_proto $noted_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT};
    server_name _;

    # Moi chuyen huong do nginx tu sinh (VD them dau "/" cuoi) phai la duong dan
    # tuong doi, KHONG kem cong noi bo 8200: nginx nam sau Cloudflare Tunnel nen
    # cong do khong the truy cap tu ben ngoai.
    absolute_redirect off;
    port_in_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    # ---- Reverse proxy toi Backend Spring Boot ----
    # BACKEND_HOST / BACKEND_PORT duoc thay the boi envsubst luc container start.
    # Trong docker-compose cung noted-net, BACKEND_HOST thuong la TEN SERVICE
    # (vd "noted-api"), Docker DNS noi bo se tu resolve sang IP container.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $noted_proto;

        # Dam bao Set-Cookie tu backend (refresh_token httpOnly) duoc forward
        # dung path, khong bi nginx tu y doi domain/path cua cookie.
        proxy_cookie_path /api/auth /api/auth;

        # Auto-save goi API lien tuc (debounce 1.3s) - khong de proxy buffer
        # lam cham phan hoi, dam bao trang thai "Da luu" cap nhat tuc thi.
        proxy_buffering off;
    }

    # Luong dang nhap Google OAuth2 (Spring Security tu dong xu ly cac path nay)
    location /oauth2/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/oauth2/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $noted_proto;
    }

    # CHI proxy /login/oauth2/ (callback Google). Truoc day la /login/: khi dang
    # nhap that bai backend chuyen ve "/login?error", nginx thay request khop 1
    # location co dau "/" cuoi nen TU chuyen huong sang "/login/?error" va gan
    # them cong 8200 (port_in_redirect) -> "https://noted...:8200/login/?error".
    # Cong 8200 chi mo o 127.0.0.1, Cloudflare Tunnel chi phuc vu 443, nen trinh
    # duyet treo toi het gio (ERR_CONNECTION_TIMED_OUT) thay vi hien trang dang
    # nhap. Thu hep location thi "/login?error" roi xuong SPA o "location /".
    location /login/oauth2/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/login/oauth2/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $noted_proto;
    }

    # ---- SPA fallback ----
    # Moi route phia client (React Router kieu client-side, neu co) khong khop
    # file tinh nao se duoc tra ve index.html, tranh loi 404 khi F5 giua route.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---- Cache tai nguyen tinh ----
    location ~* \.(?:js|css|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
                text/xml application/xml text/javascript;
}
