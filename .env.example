# ==========================================================
# Copy file nay thanh .env (gitignored). Chi dung 2 file: .env va .env.example.
# Dev local va production dung cung mau nay, chi khac gia tri.
# ==========================================================

# ==========================================================
# Bien dung khi BUILD (Vite bake vao bundle tinh, doc tu .env cho
# `pnpm dev` / `pnpm build` chay TRUC TIEP tren may, KHONG qua Docker/nginx)
# ==========================================================

# Dev (`pnpm dev`, port 8445): khong qua nginx nen phai goi THANG toi backend,
# dia chi tuyet doi, khop SERVER_PORT/API_PORT cua api (8210).
#
# Docker + nginx reverse proxy (PRODUCTION, khuyen nghi): de TRONG de FE goi
# API bang duong dan tuong doi "/api/..." (cung origin, khong CORS). Khong can
# sua .env: docker-compose.yml truyen build arg VITE_API_BASE_URL="" va gia tri
# nay uu tien hon .env (.dockerignore cung khong copy .env vao image).
VITE_API_BASE_URL=http://localhost:8210

# ==========================================================
# Bien dung khi CONTAINER KHOI DONG (chi co tac dung trong Docker, nginx
# doc qua envsubst - xem Dockerfile va nginx/default.conf.template)
# ==========================================================
PROJECT_NAME=noted
PROJECT_CODE=82
WEB_PORT=8200
BACKEND_HOST=noted-api
BACKEND_PORT=8210
